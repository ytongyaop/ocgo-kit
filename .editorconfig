# 统一各编辑器的换行、编码与缩进，避免跨平台差异带来的无意义改动
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml,json,jsonl}]
indent_style = space
indent_size = 2

[*.mjs]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 2
